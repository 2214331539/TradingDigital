APP_NAME=TradeDigital
APP_ENV=development
DEBUG=true

FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql+asyncpg://tradedigital:tradedigital@127.0.0.1:55433/tradedigital

SESSION_COOKIE_NAME=td_session
SESSION_SECRET=change-this-in-development
SESSION_EXPIRE_HOURS=24

OIDC_PROVIDER=keycloak
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/tradedigital
OIDC_CLIENT_ID=tradedigital-web
OIDC_CLIENT_SECRET=change-this-client-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/sso/callback

DEFAULT_ENTERPRISE_CODE=default
DEFAULT_LOGIN_REDIRECT=/app

DEFAULT_MODEL_DISPLAY_NAME=Gemini 3.5 Flash
DEFAULT_MODEL_PROVIDER_CODE=openai_compatible
DEFAULT_MODEL_KEY=gemini-3.5-flash
DEFAULT_MODEL_BASE_URL=https://aicenter.thyseed.com/v1
DEFAULT_MODEL_API_KEY_REF=AICENTER_API_KEY
DEFAULT_MODEL_SUPPORT_STREAMING=false
AICENTER_API_KEY=
